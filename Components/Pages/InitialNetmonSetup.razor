@using Netmon.Classes;

@rendermode InteractiveServer
@page "/InitialNetmonSetup"

@if(latestNetmon != null)
{
	<h2>New Netmon added to collection!</h2>
	<p>Name:</p>
	<input @bind="LatestNetmonName" @bind:event="oninput" />
	<p>Skin Colour: @latestNetmon.SkinColour</p>
	<p>Hair Colour: @latestNetmon.HairColour</p>
	<p>Hair Location: @latestNetmon.HairLocation</p>
	<p>Movement Type: @latestNetmon.MovementType</p>
	<p>Number of Eyes: @latestNetmon.NumEyes</p>
	<p>Attack: @latestNetmon.AttackStat</p>
	<p>Defence: @latestNetmon.DefenceStat</p>
	<p>Speed: @latestNetmon.SpeedStat</p>
}

@if(NetmonCollection.Netmons[0] == null)
{
	<button @onclick="BuildNetmon">New Netmon!</button>	
}

@if(NetmonCollection.Netmons[0] != null
	&& NetmonCollection.Netmons[2] == null
	&& !string.IsNullOrEmpty(LatestNetmonName))
{
	<button @onclick="BuildNetmon">New Netmon!</button>
}

@if(NetmonCollection.Netmons[2] != null
	&& !string.IsNullOrEmpty(LatestNetmonName))
{
	<a href="/Collection">Continue</a>
}


@code {
	NetmonBuilder builder = new();
	Netmon latestNetmon = null!;
	string latestNetmonName = "";
	public string LatestNetmonName
	{ 
		get => latestNetmonName;
		set
		{ 
			latestNetmon.SetName(value);
			latestNetmonName = value;
		} 
	}

	void BuildNetmon()
	{
		latestNetmon = builder.NewNetmon();
		NetmonCollection.AddNetmon(latestNetmon);
		LatestNetmonName = "";
	}
}
