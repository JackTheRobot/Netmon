@using Netmon.Classes;

@page "/"
@rendermode InteractiveServer

@if (netmon != null)
{
	<p>
		Your Netmon has @netmon.HairColour hair
		on its @netmon.HairLocation.
		It moves by @netmon.MovementType
		and has @netmon.NumEyes eyes.
	</p>
}

<button @onclick="BuildNetmon">Next Netmon</button>

@code
{
	NetmonBuilder builder = new();

	Netmon netmon = null!;

	void BuildNetmon()
	{
		netmon = builder.NewNetmon();
	}
}